{
  "name": "les-manager",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env api/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "tsc -p tsconfig.web.json && vite build",
    "start": "node --env-file-if-exists=.env dist/api/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "admin:create": "tsx --env-file-if-exists=.env api/create-admin.ts",
    "test": "npm run build:api && node --test tests/*.test.cjs",
    "admin:create:prod": "node dist/api/create-admin.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.19.0",
    "exceljs": "^4.4.0",
    "lucide-react": "1.64.0",
    "multer": "^2.4.0",
    "prisma": "^6.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.0"
  }
}
