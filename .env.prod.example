# Copie para .env.prod e preencha. Nunca versione o .env.prod.
POSTGRES_PASSWORD=troque-esta-senha
COOKIE_SECURE=true
# APP_BIND=127.0.0.1
# APP_PORT=3000
# Quantidade de proxies HTTPS à frente do app (padrão 1). Mantenha APP_BIND em 127.0.0.1 para
# que só o proxy alcance a porta, senão um visitante pode forjar o próprio endereço.
# TRUST_PROXY=1
# AUDIT_RETENTION_DAYS=365
# Chave mestra que cifra as credenciais bancárias salvas no painel. Obrigatória. Gere uma com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde uma cópia junto do backup do banco: sem ela, o secret e a chave do banco ficam ilegíveis.
CONFIG_ENCRYPTION_KEY=
