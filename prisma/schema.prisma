generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReferenceKind {
  GRUPO
  MARCA
  COR
  DEPARTAMENTO
}

enum MovementKind {
  INITIAL
  PURCHASE
  OUT
  ADJUSTMENT
  KIT_OUT
  INVENTORY
  PRODUCTION_IN
  PRODUCTION_OUT
  PURCHASE_REVERSAL
}

enum PurchaseCostMode {
  VALUE
  PERCENT
}

enum PurchaseCostSplit {
  VALUE
  QUANTITY
}

enum ProductionExpenseSource {
  INPUT
  MANUAL
}

enum ProductionStatus {
  PLANNED
  PRINTING
  DONE
  CANCELED
}

model Profile {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  users       User[]
}

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  passwordHash      String?
  activationHash    String?
  activationExpires DateTime?
  active            Boolean    @default(true)
  profileId         String
  profile           Profile    @relation(fields: [profileId], references: [id])
  sessions          Session[]
  movements         Movement[]
  inventoryBatches  InventoryBatch[]
  imports           InitialImport[]
  bankReconciliations BankReconciliation[]
  bankConnections   BankConnection[]
  productionOrders  ProductionOrder[]
  storedFiles       StoredFile[]
  purchases         Purchase[]       @relation("PurchaseAuthor")
  purchaseReversals Purchase[]       @relation("PurchaseReverser")
}

model Session {
  tokenHash String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model Reference {
  id          String        @id @default(uuid())
  kind        ReferenceKind
  name        String
  groups      Product[]     @relation("ProductGroup")
  brands      Product[]     @relation("ProductBrand")
  colors      Product[]     @relation("ProductColor")
  departments Product[]     @relation("ProductDepartment")
  @@unique([kind, name])
}

model UnitFamily {
  id    String @id @default(uuid())
  name  String @unique
  units Unit[]
}

model Unit {
  id           String         @id @default(uuid())
  symbol       String         @unique
  factor       Decimal        @db.Decimal(24, 12)
  isBase       Boolean        @default(false)
  familyId     String
  family       UnitFamily     @relation(fields: [familyId], references: [id])
  products     Product[]
}

/// What a product is. Behavior comes from the flags, never from the name, so types can be renamed freely.
model ProductType {
  id             String    @id @default(uuid())
  name           String    @unique
  isInput        Boolean   @default(false)
  isManufactured Boolean   @default(false)
  products       Product[]
}

model Product {
  id            String          @id @default(uuid())
  sku           String          @unique
  name          String
  typeId        String          @default("00000000-0000-4000-8000-000000000001")
  type          ProductType     @relation(fields: [typeId], references: [id])
  unitId        String
  unit          Unit            @relation(fields: [unitId], references: [id])
  groupId       String?
  group         Reference?      @relation("ProductGroup", fields: [groupId], references: [id])
  brandId       String?
  brand         Reference?      @relation("ProductBrand", fields: [brandId], references: [id])
  colorId       String?
  color         Reference?      @relation("ProductColor", fields: [colorId], references: [id])
  departmentId  String?
  department    Reference?      @relation("ProductDepartment", fields: [departmentId], references: [id])
  quantity      Decimal         @default(0) @db.Decimal(30, 12)
  currentCost   Decimal?        @db.Decimal(30, 12)
  lastPurchaseCost Decimal?     @db.Decimal(30, 12)
  lastPurchaseAt   DateTime?    @db.Date
  lastPurchaseExpense Decimal?  @db.Decimal(30, 12)
  lastSupplierId   String?
  lastSupplier     Supplier?    @relation("ProductLastSupplier", fields: [lastSupplierId], references: [id])
  minStock      Decimal?        @db.Decimal(30, 12)
  salePrice     Decimal?        @db.Decimal(30, 12)
  marginPercent Decimal?        @db.Decimal(5, 2)
  active        Boolean         @default(true)
  revision      Int             @default(0)
  wastePercent  Decimal         @default(0) @db.Decimal(5, 2)
  lengthMm      Decimal?        @db.Decimal(30, 12)
  widthMm       Decimal?        @db.Decimal(30, 12)
  heightMm      Decimal?        @db.Decimal(30, 12)
  diameterMm    Decimal?        @db.Decimal(30, 12)
  purchaseUrl   String?
  measures      ProductMeasure[]
  movements     Movement[]
  kitComponents KitComponent[]
  inventoryRows InventoryRow[]
  recipe        ProductInput[]  @relation("Recipe")
  usedInRecipes ProductInput[]  @relation("RecipeInput")
  productionItems  ProductionItem[]
  productionInputs ProductionConsumption[] @relation("ConsumptionInput")
  replacedInputs   ProductionConsumption[] @relation("ConsumptionOriginal")
  productionExpenses ProductionExpense[]
  files         ProductFile[]
  purchaseItems PurchaseItem[]
}

/// Extra measure of a product, such as thread pitch or nozzle size. It has no meaning without the product.
model ProductMeasure {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     Decimal @db.Decimal(30, 12)
  unit      String
  @@unique([productId, name])
}

/// A file kept on disk under a generated key. It is only served while `available`: false means the upload
/// has not finished or the removal has started, and the daily maintenance finishes whatever a crash interrupted.
model StoredFile {
  id           String       @id @default(uuid())
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  storageKey   String       @unique
  available    Boolean      @default(false)
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  product      ProductFile?
  purchaseDocument PurchaseDocument?
  @@index([available, updatedAt])
}

/// Attaches a stored file to a product. Other modules link files through their own table.
model ProductFile {
  fileId    String     @id
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  @@index([productId])
}

/// Technical sheet: what one base unit of a manufactured product consumes, in the input's base unit.
model ProductInput {
  productId String
  product   Product @relation("Recipe", fields: [productId], references: [id])
  inputId   String
  input     Product @relation("RecipeInput", fields: [inputId], references: [id])
  quantity  Decimal @db.Decimal(30, 12)
  @@id([productId, inputId])
  @@index([inputId])
}

model Printer {
  id         String  @id @default(uuid())
  name       String  @unique
  powerWatts Decimal @db.Decimal(12, 2)
  hourlyCost Decimal @db.Decimal(30, 12)
  active     Boolean @default(true)
  orders     ProductionOrder[]
}

/// Single row with the values shared by every production order.
model ProductionSettings {
  id         String  @id @default("default")
  energyRate Decimal @default(0) @db.Decimal(30, 12)
}

/// A print job. Machine values and costs are frozen when it finishes, so later changes never rewrite it.
model ProductionOrder {
  id               String           @id @default(uuid())
  number           Int              @unique @default(autoincrement())
  status           ProductionStatus @default(PLANNED)
  printerId        String
  printer          Printer          @relation(fields: [printerId], references: [id])
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  notes            String?
  createdAt        DateTime         @default(now())
  plannedStart     DateTime
  estimatedMinutes Int
  expectedEnd      DateTime
  startedAt        DateTime?
  finishedAt       DateTime?
  printMinutes     Int?
  powerWatts       Decimal?         @db.Decimal(12, 2)
  energyRate       Decimal?         @db.Decimal(30, 12)
  hourlyCost       Decimal?         @db.Decimal(30, 12)
  machineCost      Decimal?         @db.Decimal(30, 12)
  totalCost        Decimal?         @db.Decimal(30, 12)
  lossCost         Decimal?         @db.Decimal(30, 12)
  absorbLoss       Boolean          @default(false)
  discountPercent  Decimal          @default(0) @db.Decimal(5, 2)
  paymentMethodId  String?
  paymentMethod    PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  /// Empty follows the payment method until the order finishes, when the rate in force is frozen here.
  feePercent       Decimal?         @db.Decimal(5, 2)
  paymentName      String?
  saleGross        Decimal?         @db.Decimal(30, 12)
  saleDiscount     Decimal?         @db.Decimal(30, 12)
  saleTotal        Decimal?         @db.Decimal(30, 12)
  saleFee          Decimal?         @db.Decimal(30, 12)
  saleNet          Decimal?         @db.Decimal(30, 12)
  expenseCost      Decimal?         @db.Decimal(30, 12)
  expenses         ProductionExpense[]
  items            ProductionItem[]
  movements        Movement[]
  @@index([status])
  @@index([printerId])
  @@index([paymentMethodId])
}

/// How a sale is paid. The optional fee lowers the net value and the margin, never the cost.
model PaymentMethod {
  id         String            @id @default(uuid())
  name       String            @unique
  feePercent Decimal?          @db.Decimal(5, 2)
  active     Boolean           @default(true)
  orders     ProductionOrder[]
}

model ProductionItem {
  orderId     String
  order       ProductionOrder         @relation(fields: [orderId], references: [id])
  productId   String
  product     Product                 @relation(fields: [productId], references: [id])
  planned     Decimal                 @db.Decimal(30, 12)
  good        Decimal?                @db.Decimal(30, 12)
  lost        Decimal?                @db.Decimal(30, 12)
  unitCost    Decimal?                @db.Decimal(30, 12)
  totalCost   Decimal?                @db.Decimal(30, 12)
  lossCost    Decimal?                @db.Decimal(30, 12)
  salePrice     Decimal?              @db.Decimal(30, 12)
  marginPercent Decimal?              @db.Decimal(5, 2)
  expenseCost   Decimal?              @db.Decimal(30, 12)
  consumption ProductionConsumption[]
  @@id([orderId, productId])
  @@index([productId])
}

/// Inputs of one order item, in the input's base unit. While printing, planned is the reserved balance.
model ProductionConsumption {
  orderId   String
  productId String
  item      ProductionItem @relation(fields: [orderId, productId], references: [orderId, productId])
  inputId   String
  input     Product        @relation("ConsumptionInput", fields: [inputId], references: [id])
  /// Recipe input this line replaced in a planned order. Empty when it is the recipe's own input.
  originalInputId String?
  originalInput   Product? @relation("ConsumptionOriginal", fields: [originalInputId], references: [id], onDelete: Restrict)
  planned   Decimal        @db.Decimal(30, 12)
  used      Decimal?       @db.Decimal(30, 12)
  unitCost  Decimal?       @db.Decimal(30, 12)
  @@id([orderId, productId, inputId])
  @@index([inputId])
  @@index([originalInputId])
}

/// Extra cost of an order. An INPUT row follows the last purchase expense × consumption until someone types a value.
model ProductionExpense {
  id      String                  @id @default(uuid())
  orderId String
  order   ProductionOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  source  ProductionExpenseSource
  inputId String?
  input   Product?                @relation(fields: [inputId], references: [id], onDelete: Restrict)
  title   String
  value   Decimal                 @db.Decimal(30, 12)
  edited  Boolean                 @default(false)
  @@unique([orderId, inputId])
  @@index([inputId])
}

model Movement {
  id        String       @id @default(uuid())
  kind      MovementKind
  quantity  Decimal      @db.Decimal(30, 12)
  unitCost  Decimal?     @db.Decimal(30, 12)
  createdAt DateTime     @default(now())
  reason    String
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  kitId     String?
  kit       Kit?         @relation(fields: [kitId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  purchaseItem      PurchaseItem?
  @@index([productId, createdAt])
  @@index([productionOrderId])
}

/// Who a purchase came from. A supplier with history is inactivated instead of removed.
model Supplier {
  id           String         @id @default(uuid())
  name         String         @unique
  document     String?        @unique
  contact      String?
  active       Boolean        @default(true)
  purchases    Purchase[]
  lastProducts Product[]      @relation("ProductLastSupplier")
  undoItems    PurchaseItem[] @relation("PurchaseItemPreviousSupplier")
}

/// A purchase document. The date is informative: stock and average change when it is posted.
model Purchase {
  id             String         @id @default(uuid())
  number         Int            @unique @default(autoincrement())
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])
  documentNumber String?
  purchaseDate   DateTime       @db.Date
  notes          String?
  goodsTotal     Decimal        @db.Decimal(30, 12)
  costsTotal     Decimal        @default(0) @db.Decimal(30, 12)
  /// Converted from a movement older than this module. It has no stored previous state, so it cannot be reversed.
  converted      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  userId         String
  user           User           @relation("PurchaseAuthor", fields: [userId], references: [id])
  reversedAt     DateTime?
  reversalReason String?
  reversedById   String?
  reversedBy     User?          @relation("PurchaseReverser", fields: [reversedById], references: [id])
  items          PurchaseItem[]
  costs          PurchaseCost[]
  documents      PurchaseDocument[]
  @@index([createdAt])
  @@index([supplierId])
  @@index([purchaseDate])
}

/// Declared in the alphabetical order of the Portuguese labels, because the database sorts an enum by its declaration.
enum PurchaseDocumentType {
  PAYMENT_PROOF
  INVOICE
  QUOTE
  OTHER
  RECEIPT
}

/// Attaches a stored file to a purchase. Any purchase accepts documents, including converted and reversed ones.
model PurchaseDocument {
  fileId     String               @id
  file       StoredFile           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  purchaseId String
  purchase   Purchase             @relation(fields: [purchaseId], references: [id])
  type       PurchaseDocumentType
  @@index([purchaseId])
  @@index([type])
}

/// One product of a purchase. Repeated lines are merged, so each product has one movement and one undo state.
model PurchaseItem {
  id                  String             @id @default(uuid())
  purchaseId          String
  purchase            Purchase           @relation(fields: [purchaseId], references: [id])
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  movementId          String             @unique
  movement            Movement           @relation(fields: [movementId], references: [id])
  declaredQuantity    Decimal            @db.Decimal(30, 12)
  declaredUnit        String
  quantity            Decimal            @db.Decimal(30, 12)
  goodsTotal          Decimal            @db.Decimal(30, 12)
  unitCost            Decimal?           @db.Decimal(30, 12)
  expenseTotal        Decimal            @default(0) @db.Decimal(30, 12)
  unitExpense         Decimal            @default(0) @db.Decimal(30, 12)
  /// Product revision right after this entry. A different value means something happened later.
  revisionAfter       Int?
  previousCost        Decimal?           @db.Decimal(30, 12)
  previousLastCost    Decimal?           @db.Decimal(30, 12)
  previousLastAt      DateTime?          @db.Date
  previousLastExpense Decimal?           @db.Decimal(30, 12)
  previousSupplierId  String?
  previousSupplier    Supplier?          @relation("PurchaseItemPreviousSupplier", fields: [previousSupplierId], references: [id])
  shares              PurchaseItemCost[]
  @@unique([purchaseId, productId])
  @@index([productId])
}

/// Extra cost of a purchase, such as freight. It never enters the moving average.
model PurchaseCost {
  id         String             @id @default(uuid())
  purchaseId String
  purchase   Purchase           @relation(fields: [purchaseId], references: [id])
  title      String
  mode       PurchaseCostMode
  value      Decimal            @db.Decimal(30, 12)
  split      PurchaseCostSplit
  amount     Decimal            @db.Decimal(30, 12)
  shares     PurchaseItemCost[]
  @@index([purchaseId])
}

/// How much of one extra cost fell on one item.
model PurchaseItemCost {
  itemId String
  item   PurchaseItem @relation(fields: [itemId], references: [id])
  costId String
  cost   PurchaseCost @relation(fields: [costId], references: [id])
  amount Decimal      @db.Decimal(30, 12)
  @@id([itemId, costId])
  @@index([costId])
}

model Kit {
  id         String         @id @default(uuid())
  sku        String         @unique
  name       String
  active     Boolean        @default(true)
  components KitComponent[]
  movements  Movement[]
}

model KitComponent {
  kitId     String
  kit       Kit     @relation(fields: [kitId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(30, 12)
  @@id([kitId, productId])
}

model InventoryBatch {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now())
  confirmedAt DateTime?
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  rows        InventoryRow[]
}

model InventoryRow {
  batchId   String
  batch     InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  expected  Decimal        @db.Decimal(30, 12)
  counted   Decimal        @db.Decimal(30, 12)
  revision  Int
  @@id([batchId, productId])
}

model InitialImport {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  data        Json
  userId      String
  user        User      @relation(fields: [userId], references: [id])
}

model BankBalance {
  provider  String   @id
  available Decimal  @db.Decimal(24, 2)
  updatedAt DateTime
}

model BankDay {
  provider  String
  date      String
  entries   Json
  updatedAt DateTime
  @@id([provider, date])
}

model AuditEvent {
  id          String    @id @default(uuid())
  action      String
  actorId     String?
  actorName   String?
  targetId    String?
  status      Int?
  details     Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  @@index([createdAt, id])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model BankReconciliation {
  provider  String
  date      String
  key       String
  reference String?
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  @@id([provider, date, key])
}

/// Bank credentials set up in the panel. secret and privateKey are encrypted with api/vault.ts.
model BankConnection {
  provider           String   @id
  environment        String
  clientId           String
  account            String?
  secret             String
  certificate        String
  privateKey         String
  certificateExpires DateTime
  updatedAt          DateTime @updatedAt
  updatedById        String
  updatedBy          User     @relation(fields: [updatedById], references: [id])
}
